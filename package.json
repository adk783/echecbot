{
  "name": "echec",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Play chess against a Stockfish WASM bot",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "copy-engine": "node scripts/copy-stockfish.mjs",
    "postinstall": "node scripts/copy-stockfish.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
